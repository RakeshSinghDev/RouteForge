{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RouteForge",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Iinclude",
                "src/main.cpp",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}